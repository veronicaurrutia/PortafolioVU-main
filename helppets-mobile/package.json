{
  "name": "helppets-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean && npx instrumentDynatrace",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@dynatrace/react-native-plugin": "^2.349.1",
    "@microsoft/react-native-clarity": "^4.9.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@reduxjs/toolkit": "^2.13.0",
    "expo": "~58.0.20",
    "expo-dev-client": "~58.0.16",
    "expo-status-bar": "~58.0.4",
    "firebase": "^13.1.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-redux": "^9.3.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.21",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.12",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ],
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@react-navigation/.*|immer|reselect|redux|@reduxjs/.*|react-redux)"
    ]
  }
}
