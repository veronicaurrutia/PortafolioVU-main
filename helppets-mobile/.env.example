# Copia este archivo como .env y completa los valores.

# Firebase → Configuración del proyecto → Tus apps → App web
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Microsoft Clarity → Settings → Overview → Project ID
EXPO_PUBLIC_CLARITY_PROJECT_ID=

EXPO_PUBLIC_APP_ENV=development

# Dynatrace (solo se usan al correr `npm run prebuild`, no llegan al bundle JS)
DT_APPLICATION_ID=
DT_BEACON_URL=
