rules_version = '2';

// Reglas de seguridad: la API key de Firebase es pública, la seguridad real vive aquí.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid);
    }

    match /pets/{petId} {
      allow read: if signedIn();
      // Solo puedes publicar a tu nombre, y con un estado válido.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status in ['lost', 'seen', 'found']
        && request.resource.data.description is string
        && request.resource.data.description.size() < 2000;
      // Solo el dueño puede editar, y no puede transferir la alerta a otro usuario.
      allow update: if isSelf(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSelf(resource.data.ownerId);
    }

    match /chats/{chatId} {
      function isParticipant() { return signedIn() && request.auth.uid in resource.data.participants; }

      // get de un chat inexistente devuelve resource == null → se permite para poder crearlo.
      allow get: if resource == null || isParticipant();
      allow list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isParticipant()
        && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        function chat() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        allow read: if signedIn() && request.auth.uid in chat().participants;
        allow create: if signedIn()
          && request.auth.uid in chat().participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
      }
    }
  }
}
